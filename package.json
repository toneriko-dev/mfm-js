{
	"type": "module",
	"name": "mfm-js",
	"version": "0.26.0",
	"description": "MFM parser implementation (Misskey fork)",
	"author": "Marihachi",
	"license": "MIT",
	"private": true,
	"homepage": "https://github.com/misskey-dev/mfm.js",
	"exports": {
